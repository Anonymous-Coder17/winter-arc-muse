# Copy to .env.local and fill in. Never commit real values.
# Create a Supabase project at https://supabase.com, then apply all SQL files
# in supabase/migrations/ in ascending order (0001 -> latest).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Account deletion (V4.8.1) ----
# SERVER-ONLY: required for "Delete my account" to remove the Supabase Auth
# identity (auth.users). Never prefix with NEXT_PUBLIC_ — it must never
# reach the client bundle. Used only via lib/supabase/admin.ts (guarded by
# `import "server-only"`), isolated to the account-deletion operation.
# Without it, POST /api/account/delete fails safely BEFORE deleting any
# application data. Find it in Supabase Dashboard → Project Settings → API.
# Do NOT commit real values to git.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Calendar integration (V4.3.3) ----
# Full setup guide: docs/google-calendar-setup.md
# SERVER-ONLY: never prefix these with NEXT_PUBLIC_ — they must never reach
# the client bundle. The google-auth-library + token vault live in
# lib/google/*, guarded by `import "server-only"`.
# Do NOT commit real values to git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key for AES-256-GCM token encryption at rest.
# Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional. Defaults to <app-origin>/api/google/oauth/callback.
# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=
